extends RefCounted

static func draw(a, symbol: String) -> void:
	match symbol:
		"veil": veil(a)
		"fruit": fruit(a)
		"lantern": lantern(a)

static func veil(a) -> void:
	a.poly([-12,-22,-4,-28,7,-26,16,-18,17,-3,25,14,28,26,13,20,5,29,-4,22,-14,28,-28,23,-22,9,-17,-6],a.PAPER,3)
	a.poly([-10,-18,-9,0,-17,18,-12,23,-3,13,-2,-8,3,-18],Color("a5aa8e"),1.8)
	a.poly([6,-20,9,-7,8,6,17,21,23,23,16,5,15,-10],Color("a5aa8e"),1.8)
	a.poly([-8,-11,0,-18,9,-11,6,2,0,8,-7,2],a.IRON,2)
	a.line([-2,-10,-3,-2],a.PAPER,1.6)
	a.line([3,-9,4,-3],a.PAPER,1.6)
	a.poly([-15,-20,-7,-26,4,-27,15,-20,12,-16,-1,-21,-12,-16],Color("7c8969"),2)
	a.gem(0,-22,4,6,a.GOLD)
	a.leaf(-11,-18,-1,Color("a5aa73"))
	a.line([-20,16,-23,22,-17,23],a.INK,1.5)
	a.line([3,11,2,22,5,25],a.INK,1.5)

static func fruit(a) -> void:
	a.poly([-1,-5,1,-21,9,-28,12,-26,6,-18,6,-4],a.WOOD,2.6)
	a.leaf(4,-14,1,Color("8b9b72"))
	a.leaf(0,-11,-1,Color("a5aa73"))
	a.poly([-1,-7,-13,-11,-25,-6,-29,4,-26,16,-18,25,-6,28,1,24,9,28,22,23,29,12,28,1,20,-7,9,-10],Color("c5c7a0"),3)
	a.poly([1,-5,-2,6,0,20,-5,24,-14,22,-21,15,-23,4,-17,-3,-8,-6],a.PAPER,0)
	a.poly([17,-4,23,3,24,12,18,20,10,23,8,19,16,12],Color("9ba37c"),0)
	a.line([2,-3,-1,6,2,15,1,23],a.INK,1.7)
	a.line([-18,1,-21,5,-20,10],a.WOOD,1.8)
	a.poly([-10,4,-5,7,-8,10],a.IRON,1.2)
	a.poly([9,4,14,2,12,8],a.IRON,1.2)
	a.line([-9,17,-4,19],a.WOOD,1.5)
	a.gem(11,-18,2,4,a.GOLD)

static func lantern(a) -> void:
	a.link(0,-27,a.GOLD)
	a.poly([-10,-20,0,-25,10,-20,19,-12,15,-8,-15,-8,-19,-12],Color("a5aa8e"),2.8)
	a.poly([-19,-10,19,-10,23,21,15,29,-15,29,-23,21],a.IRON,3)
	a.poly([-13,-5,13,-5,15,20,-15,20],a.MINT,2)
	a.poly([-11,-2,-4,-2,-8,16,-13,17],a.PAPER,0)
	a.poly([5,-2,11,-2,13,17,4,17],Color("729f91"),0)
	a.poly([0,-1,-6,8,-5,14,0,18,6,12,5,6,2,9],a.PAPER,1.8)
	a.line([-13,-5,-15,20],a.GOLD,2.8)
	a.line([13,-5,15,20],a.GOLD,2.8)
	a.poly([-22,19,22,19,19,25,-19,25],a.GOLD,2.6)
	a.poly([-11,26,11,26,7,31,-7,31],Color("a5aa8e"),2)
	for x in [-16,16]:
		a.rivet(x,-9)
		a.rivet(x,22)
	a.line([-12,-14,0,-20,12,-14],a.INK,1.6)
